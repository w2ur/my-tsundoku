# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# editors
.vscode/
.idea/

# backup exports
*.backup.json
*.bak
*.dump
*.sql
!supabase/migrations/*.sql

# plan files
docs/plans/

# Claude Code per-agent memory and local state (never the whole .claude/,
# which would silently untrack any project skill written there)
.claude/agent-memory/
.claude/agent-memory-local/
.claude/worktrees/
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serwist
public/sw.js
public/sw.js.map

# playwright MCP
.playwright-mcp/

# audit/readiness reports (not committed)
readiness-report.md
audit-report-*.md
