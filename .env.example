NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Used by the /api/keepalive cron to prevent Supabase from auto-pausing the project.
# Generate any random string; Vercel injects it as the Bearer token on cron requests.
CRON_SECRET=generate-a-random-string

# Server-only. Used by the /api/purge-covers cron to delete cover files from Storage
# (queued by the soft-delete purge and by failed account deletions). Never prefix with NEXT_PUBLIC_.
# Vercel Production scope only; the route refuses to run without CRON_SECRET too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
